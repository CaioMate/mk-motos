# Copie este arquivo para ".env" (na mesma pasta) e preencha. Depois reinicie o sistema.

# Porta do servidor (padrão 8000). Acesse pela rede local em http://IP-DO-PC:8000
PORT=8000

# Senha para entrar no painel. OBRIGATÓRIA para usar o sistema pela internet.
# Se ficar vazia, o painel abre sem senha, mas só na rede local. Trocar a senha desconecta todo mundo.
# AVISO: sem SENHA_PAINEL a proteção "só rede local" depende de cabeçalhos de proxy (cf-connecting-ip etc.) e NÃO é
# segurança forte. Nunca exponha o servidor à internet (redirecionamento de porta/túnel) sem definir SENHA_PAINEL.
# Na Vercel a senha precisa ter pelo menos 10 caracteres.
SENHA_PAINEL=

# Caminho do banco de dados SQLite (padrão: data/mkmotos.db)
# MKMOTOS_DB=C:\MKMotos\dados\mkmotos.db

# ---------------- WhatsApp — API oficial da Meta (WhatsApp Business Cloud API)
# developers.facebook.com > seu app > WhatsApp > Configuração da API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Senha que você inventa e coloca também no campo "Token de verificação" do webhook na Meta
WHATSAPP_VERIFY_TOKEN=
# Configurações do app > Básico > Chave secreta do app (valida que as mensagens vieram da Meta)
# OBRIGATÓRIA com SENHA_PAINEL ou na Vercel: sem ela o webhook (POST) é recusado.
WHATSAPP_APP_SECRET=
# Modelo aprovado para avisos fora da janela de 24h (veja Configurações > WhatsApp e agente)
WHATSAPP_TEMPLATE=aviso_mk_motos
WHATSAPP_TEMPLATE_IDIOMA=pt_BR

# ---------------- GPS: senha dos rastreadores. Eles enviam ?token=... na URL (ou Authorization: Bearer / X-GPS-Token).
# Em Configurações > GPS o painel mostra a URL pronta. Se ficar vazia e houver SENHA_PAINEL, o sistema gera um token
# fixo sozinho (muda se a senha/SESSAO_SEGREDO mudar). Sem SENHA_PAINEL e sem GPS_TOKEN (só rede local) o token é opcional.
GPS_TOKEN=

# ---------------- Agente de IA (Claude) — lê comprovantes e responde clientes
# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# ---------------- Supabase - guarda os dados de forma PERMANENTE (OBRIGATÓRIO na Vercel)
# No computador, deixe as duas vazias para usar só arquivos locais, como sempre foi.
# Supabase > Project Settings > API: "Project URL" e a chave "service_role" (secreta! nunca divulgue).
# Antes, rode o arquivo supabase/esquema.sql no SQL Editor do Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------- Só para a VERCEL (painel da Vercel > Settings > Environment Variables; não precisa no computador)
# Lista completa na Vercel:
#   OBRIGATÓRIAS: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SENHA_PAINEL (acima), SESSAO_SEGREDO
#   Recomendada:  CRON_SECRET
#   Opcionais:    WHATSAPP_* e ANTHROPIC_API_KEY (acima)
# Texto longo e aleatório (30+ caracteres) que assina o cookie de login. Precisa ser FIXO e igual em todos os servidores.
# Gere um em: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSAO_SEGREDO=
# Senha da chamada periódica GET /api/cron (rotinas + fila do WhatsApp). Na Vercel, o cron diário usa esta variável sozinho.
# Para rodar a cada 5 min, cadastre um serviço grátis (ex.: cron-job.org) chamando https://SEU-SITE.vercel.app/api/cron
# com o cabeçalho  Authorization: Bearer <o mesmo valor>. Sem ela, a rota fica desligada (404).
CRON_SECRET=
