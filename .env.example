# Copie este arquivo para ".env" (na mesma pasta) e preencha. Depois reinicie o sistema.

# Porta do servidor (padrão 8000). Acesse pela rede local em http://IP-DO-PC:8000
PORT=8000

# Caminho do banco de dados SQLite (padrão: data/mkmotos.db)
# MKMOTOS_DB=C:\MKMotos\dados\mkmotos.db

# ---------------- WhatsApp — API oficial da Meta (WhatsApp Business Cloud API)
# developers.facebook.com > seu app > WhatsApp > Configuração da API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Senha que você inventa e coloca também no campo "Token de verificação" do webhook na Meta
WHATSAPP_VERIFY_TOKEN=
# Configurações do app > Básico > Chave secreta do app (valida que as mensagens vieram da Meta)
WHATSAPP_APP_SECRET=
# Modelo aprovado para avisos fora da janela de 24h (veja Configurações > WhatsApp e agente)
WHATSAPP_TEMPLATE=aviso_mk_motos
WHATSAPP_TEMPLATE_IDIOMA=pt_BR

# ---------------- Agente de IA (Claude) — lê comprovantes e responde clientes
# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
