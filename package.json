{
  "name": "mk-motos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --no-warnings=ExperimentalWarning --import tsx server/index.ts",
    "build": "vite build",
    "build:vercel": "node scripts/build-vercel.mjs",
    "start": "vite build && node --no-warnings=ExperimentalWarning --import tsx server/index.ts --producao",
    "servidor": "node --no-warnings=ExperimentalWarning --import tsx server/index.ts --producao",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@google/genai": "^2.28.0",
